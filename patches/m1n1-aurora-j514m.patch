diff --git a/tests/python/test_j514m_external_dispatch.py b/tests/python/test_j514m_external_dispatch.py
new file mode 100644
index 0000000..d906a12
--- /dev/null
+++ b/tests/python/test_j514m_external_dispatch.py
@@ -0,0 +1,82 @@
+# SPDX-License-Identifier: MIT
+"""Catch a J514M profile that silently skips the external handoff dispatcher."""
+from pathlib import Path
+from test_siliconforest_handoff import run_c
+
+ROOT = Path(__file__).resolve().parents[2]
+
+
+def block(source, start, end):
+    a = source.index(start)
+    return source[a:source.index(end, a) + len(end)]
+
+
+def test_j514m_profile_dispatches_opted_in_external_handoff(tmp_path):
+    s = (ROOT / 'src/kboot_display_handoff.c').read_text()
+    code = r'''
+#include <assert.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <string.h>
+#include "libfdt.h"
+typedef uint32_t u32;
+typedef uint64_t u64;
+#define T6034 0x6034
+#define T8122 0x8122
+#define V14_7 1
+#define DCP6_DART_VM_BASE 0x10000000000ULL
+#define DCP6_DART_VM_SIZE 0x1000000000ULL
+#define ARRAY_SIZE(a) (sizeof(a) / sizeof((a)[0]))
+#define dlog(...) ((void)0)
+struct dcp6_seg_def;
+''' + block(s, 'struct dcp_soc {', '\n};') + '\n' + block(
+        s, 'static const char *const dcp_boards_t6034[]', '\n};') + r'''
+static const struct dcp_soc dcp_soc_j516m = {0}, dcp_soc_j613_25g83 = {0};
+static const struct dcp_soc *const dcp_socs[] = { &dcp_soc_t6034 };
+static struct { const struct dcp_soc *soc; } dcp6;
+static unsigned int chip_id;
+static int external_calls;
+static bool dcp25_selected(void *dt) { return false; }
+static void dcp6_describe(void) {}
+static void dcp6_find_nubs(void) {}
+static void dcp6_reserve_oslogs(void *dt) {}
+static void dcp6_check_hw(void) {}
+static void dcp6_dry_run(void) {}
+static void dcp6_handoff(void *dt) {}
+''' + block(s, 'static bool dcp6_board_ok(', '\n}') + '\n' + block(
+        s, 'static bool dcp6_armed(', '\n}') + '\n' + block(
+        s, 'static bool dcpext6_flag(', '\n}') + r'''
+/* Hardware publication is the boundary: observe whether dispatch reaches it. */
+static void dcpext6_handoffs(void *dt)
+{
+    if (dcpext6_flag(dt, "asahi,t6034-dispext"))
+        external_calls++;
+}
+''' + block(s, 'int dt_set_display_handoff(', '\n}') + r'''
+static void check(const char *board, unsigned int chip, const char *flag, int want)
+{
+    unsigned char dt[4096];
+    assert(!fdt_create_empty_tree(dt, sizeof(dt)));
+    assert(!fdt_setprop_string(dt, 0, "compatible", board));
+    assert(!fdt_appendprop_string(dt, 0, "compatible", "apple,t6034"));
+    int chosen = fdt_add_subnode(dt, 0, "chosen");
+    assert(chosen >= 0);
+    assert(!fdt_setprop_string(dt, chosen, "asahi,t6034-dcp", "1"));
+    if (flag) assert(!fdt_setprop_string(dt, chosen, "asahi,t6034-dispext", flag));
+    external_calls = 0;
+    chip_id = chip;
+    assert(!dt_set_display_handoff(dt));
+    assert(external_calls == want);
+}
+int main(void)
+{
+    check("apple,j514m", T6034, "1", 1);
+    check("apple,j514m", T6034, NULL, 0);
+    check("apple,j514m", T6034, "0", 0);
+    check("apple,j514m", T6034, "01", 0);
+    check("apple,j514m", 0x6031, "1", 0);
+    check("apple,j999", T6034, "1", 0);
+    return 0;
+}
+'''
+    run_c(tmp_path, 'j514m-external-dispatch', code)
